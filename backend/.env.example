# Only needed for arbitrary addresses; UMD demo location is built in.
GEOAPIFY_API_KEY=7e04b2e779304036a26e1409c97351d7
SITE2MODEL_USER_AGENT=Site2ModelMVP/0.1 (vojdani@umd.edu)
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
TOPO_URL=https://api.opentopodata.org/v1/srtm90m
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Overpass mirror URLs and successful response cache duration
OVERPASS_BACKUP_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_THIRD_URL=https://overpass-api.de/api/interpreter
OVERPASS_FOURTH_URL=https://overpass.osm.jp/api/interpreter
OSM_CACHE_SECONDS=86400
OVERPASS_TIMEOUT_SECONDS=25
OSM_ALLOW_EMPTY_FALLBACK=true
OSM_MAP_URL=https://api.openstreetmap.org/api/0.6/map

# Optional validated simulation engines. EnergyPlus also needs at least one
# .epw weather file in WEATHER_EPWS_DIR (never commit weather files or secrets).
ENERGYPLUS_BIN=energyplus
WEATHER_EPWS_DIR=./weather
DEFAULT_EPW_FILE=
RADIANCE_OCONV_BIN=oconv
RADIANCE_RTRACE_BIN=rtrace
RADIANCE_GENSKY_BIN=gensky
SIMULATION_TIMEOUT_SECONDS=300
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
EPW_CATALOG_URL=https://raw.githubusercontent.com/ladybug-tools/epwmap/gh-pages/data/epw_weather_data.csv
